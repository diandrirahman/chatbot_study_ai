# Backend only. Never expose this value via VITE_ variables.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
# Set to 100 on Cloud Run. Keep 0 locally unless Firestore credentials or an emulator are configured.
AI_DAILY_LIMIT=0
AI_HOURLY_IP_LIMIT=20
APP_TIMEZONE=Asia/Jakarta
